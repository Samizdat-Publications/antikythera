{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "antikythera-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5177",
        "--strictPort",
        "--host",
        "127.0.0.1"
      ],
      "port": 5177
    },
    {
      "name": "antikythera-site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5179",
        "--bind",
        "127.0.0.1",
        "--directory",
        "site"
      ],
      "port": 5179
    }
  ]
}