# Cloudflare Workers static assets reads this file and does not serve it.
# Vite names every bundle after a hash of its contents, so a bundle never changes under its name
# and a browser may keep it a year without asking. Everything else keeps Cloudflare's default
# (revalidate each time against the ETag), and the service worker's shelf does the rest.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
